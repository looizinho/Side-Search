          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando o assistente..."
          }
        }
      }
    },
    "With a compatible assistant, you can continue conversations in the background even if you close Side Search during speech recognition." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応するアシスタントでは、音声認識中にアプリを閉じてもバックグラウンドで会話を続けることができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com um assistente compatível, você pode continuar conversas em segundo plano mesmo fechando o Side Search durante o reconhecimento de voz."
          }
        }
      }
    },
    "Yahoo" : {
      "localizations" : {
        "ja" : {
